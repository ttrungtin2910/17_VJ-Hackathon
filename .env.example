APP_ENV=development
APP_NAME=Garblo API
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+psycopg://garblo:garblo@localhost:5432/garblo
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
ENABLE_API_MOCK_UI=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RustFS / S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=garblo
S3_SECRET_KEY=replace-me
S3_BUCKET=garblo-assets
S3_REGION=us-east-1
S3_PRESIGN_SECONDS=900
MAX_UPLOAD_BYTES=10485760

# Azure OpenAI. Every AI route returns 503 until all required fields are present.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=

