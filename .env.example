APP_ENV=development
APP_NAME=Garblo API
API_V1_PREFIX=/v1
MONGODB_URI=mongodb://garblo:garblo@localhost:27017/garblo?authSource=admin
MONGODB_DATABASE=garblo
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_INITDB_ROOT_USERNAME=garblo
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
ENABLE_API_MOCK_UI=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RustFS / S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
# URL exposed to browser/host for presigned download links. In Compose this differs from S3_ENDPOINT_URL.
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=garblo
S3_SECRET_KEY=replace-with-a-strong-local-secret
S3_BUCKET=garblo-assets
S3_REGION=us-east-1
S3_PRESIGN_SECONDS=900
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_BATCH_FILES=20
MAX_UPLOAD_BATCH_BYTES=104857600

# AI providers. Never commit the values in your real .env.
FPT_API_KEY=
FPT_BASE_URL=https://token-api.fpt.ai
FPT_MODEL=Azure:gpt-5.6-terra
FPT_MAX_TOKENS=10000
OPEN_AI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_IMAGE_MODEL=gpt-image-2
METADATA_EMBEDDING_DIMENSIONS=3072

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=garblo_garments
QDRANT_TIMEOUT_SECONDS=10
IMAGE_EMBEDDING_DIMENSIONS=768

# Local ML models (installed by the ml image/profile only)
DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
IMAGE_EMBEDDING_MODEL=google/siglip2-base-patch16-224
ML_DEVICE=auto
WORKER_POLL_SECONDS=2
