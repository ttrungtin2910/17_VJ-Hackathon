APP_ENV=development
APP_NAME=Garblo API
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+psycopg://garblo:garblo@localhost:5432/garblo
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
ENABLE_API_MOCK_UI=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# RustFS / S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=garblo
S3_SECRET_KEY=replace-me
S3_BUCKET=garblo-assets
S3_REGION=us-east-1
S3_PRESIGN_SECONDS=900
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
# Nếu API dùng endpoint nội bộ container, presign bằng endpoint browser truy cập được.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:19000

# OpenAI direct là mặc định; catalogue cần key + VLM model, lookbook cần thêm image model.
# Điền model ID đã được xác minh trong organization, không dùng tên Azure deployment.
OPENAI_API_KEY=
OPENAI_VLM_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_TIMEOUT_SECONDS=120

# Optional: chỉ thêm key này và khởi động lại API + worker để chọn FPT ở catalogue.
FPT_VLM_API_KEY=
# FPT_VLM_BASE_URL=https://mkp-api.fptcloud.com/v1
# FPT_VLM_MODEL=Qwen2.5-VL-7B-Instruct
# FPT_VLM_TIMEOUT_SECONDS=60

WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=900
WORKER_RETRY_BASE_SECONDS=5

# Legacy Azure: chỉ giữ cho job đã pin Azure và model snapshot, không fallback.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
