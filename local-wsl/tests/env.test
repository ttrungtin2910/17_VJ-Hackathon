# Cấu hình riêng, không chứa credential AI; chỉ dùng project garblo-local-wsl-test.
APP_ENV=test
ENABLE_API_MOCK_UI=false
OPENAI_API_KEY=
FPT_VLM_API_KEY=
OPENAI_VLM_MODEL=gpt-5.4-mini-2026-03-17
POSTGRES_USER=garblo
POSTGRES_PASSWORD=garblo-test-only
POSTGRES_DB=garblo_test
DATABASE_URL=postgresql+psycopg://garblo:garblo-test-only@postgres:5432/garblo_test
JWT_SECRET_KEY=garblo-test-only-stable-key-for-isolated-project
S3_ACCESS_KEY=garblo-test
S3_SECRET_KEY=garblo-test-only-storage-secret
S3_BUCKET=garblo-test-assets
S3_ENDPOINT_URL=http://rustfs:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:19001
LOCAL_STORAGE_CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
VITE_API_BASE_URL=http://localhost:18081/v1
WEB_PORT=5183
API_PORT=18081
MEDIA_PORT=19001
