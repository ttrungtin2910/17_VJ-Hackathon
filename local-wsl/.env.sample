# Chỉ dùng phát triển local WSL; không dùng các secret mặc định này ở production.
# Chỉ cần nhập OPENAI_API_KEY. Không đặt key vào biến VITE_*.
OPENAI_API_KEY=
# Profile vision/schema chính thức, Chat Completions; access của account cần test riêng.
OPENAI_VLM_MODEL=gpt-5.4-mini-2026-03-17
# Catalogue v2 tạo PNG riêng cho từng món; cần quyền Images Edits trong tài khoản.
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_TIMEOUT_SECONDS=120
CATALOGUE_NATIVE_STRUCTURED_OUTPUT=true
CATALOGUE_SUPPORTS_TEMPERATURE=false
CATALOGUE_SCHEMA_VERSION=2
CATALOGUE_COMPONENT_IMAGE_CONCURRENCY=5
CATALOGUE_MAX_CALLS=12
CATALOGUE_MAX_OUTPUT_TOKENS=4096
CATALOGUE_TOKEN_BUDGET=200000
CATALOGUE_CALL_TOKEN_RESERVATION=16384
CATALOGUE_DEADLINE_SECONDS=300
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=900
# FPT chỉ fallback vision; bỏ trống vẫn chạy OpenAI-only.
FPT_VLM_API_KEY=
FPT_VLM_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_VLM_MODEL=Qwen2.5-VL-7B-Instruct
FPT_VLM_TIMEOUT_SECONDS=60
CATALOGUE_FPT_FALLBACK_ENABLED=true
APP_ENV=development
ENABLE_API_MOCK_UI=false
POSTGRES_USER=garblo
POSTGRES_PASSWORD=garblo-local-wsl-dev-only
POSTGRES_DB=garblo
DATABASE_URL=postgresql+psycopg://garblo:garblo-local-wsl-dev-only@postgres:5432/garblo
JWT_SECRET_KEY=garblo-local-wsl-dev-only-stable-secret-do-not-use-in-production
JWT_ACCESS_TOKEN_MINUTES=60
S3_ACCESS_KEY=garblo-local
S3_SECRET_KEY=garblo-local-wsl-storage-dev-only
S3_BUCKET=garblo-assets
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://rustfs:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:19000
S3_PRESIGN_SECONDS=900
LOCAL_STORAGE_CORS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chỉ các biến public sau được truyền vào FE build; API root đã có /v1.
VITE_DATA_MODE=real
VITE_API_BASE_URL=http://localhost:18080/v1
WEB_PORT=5173
API_PORT=18080
MEDIA_PORT=19000

GARBLO_WORKER_REPLICAS=1
